// Reglas RECOMENDADAS para el Mural de Luz (no están publicadas).
// El proyecto instalacionmariposas se comparte con CaboHealth y hoy tiene reglas abiertas;
// antes de publicar esto hay que juntarlo con las reglas de las otras apps.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fila de mensajes: el celular crea, la pantalla lee y borra
    match /mural-de-luz-mensajes/{id} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 140
        && (!('color' in request.resource.data) || request.resource.data.color in ['oro', 'rosa', 'cielo', 'jade', 'lavanda'])
        && (!('power' in request.resource.data) || (request.resource.data.power is number && request.resource.data.power >= 0 && request.resource.data.power <= 1));
    }
    // Respaldo de la noche: lo escribe la pantalla al mostrar cada mensaje; el celular solo cuenta
    match /mural-de-luz-historia/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 140;
    }
    // Estado de la noche (inicio y cuenta regresiva)
    match /mural-de-luz-estado/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
